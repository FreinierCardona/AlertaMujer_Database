# Plantilla de configuración local. Copiar a .env y completar.
# NOTA: en Compose el símbolo $ literal se escribe como $$.
POSTGRES_DB=alertamujer_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
# Puerto local de PostgreSQL para AlertaMujer.
POSTGRES_PORT=5434
# Puerto de PostgreSQL dentro del contenedor.
POSTGRES_CONTAINER_PORT=5433
# Nombre del proyecto Compose; identifica la infraestructura local del proyecto.
COMPOSE_PROJECT_NAME=alertamujer-db
# Usuario de aplicación sin privilegios administrativos.
APP_DB_USER=alertamujer_app
APP_DB_PASSWORD=CAMBIAR
